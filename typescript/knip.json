{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": [
        "*.mjs"
      ]
    },
    "packages/precedent-iso": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/source-collector": {
      "entry": [
        "src/collection/collection-source-browser.ts",
        "src/source-adapter/index.ts",
        "src/**/__tests__/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/operations": {
      "entry": [
        "src/app/**/*.{ts,tsx}",
        "open-next.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "*.{ts,mjs}"
      ]
    },
    "packages/site": {
      "entry": [
        "src/pages/**/*.{astro,ts}"
      ],
      "project": [
        "src/**/*.{astro,ts,tsx}",
        "tests/*.{mjs,ts}"
      ]
    }
  },
  "ignoreDependencies": [
    "eslint-plugin-simple-import-sort",
    "cloudflare",
    "@eslint/js",
    "react-doctor",
    "tailwindcss",
    "typescript-eslint"
  ],
  "ignore": [
    "eslint.strict.mjs"
  ],
  "ignoreExportsUsedInFile": false
}
