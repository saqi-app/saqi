  "source": {
    "content": [
      "قرت عُيون السَعادَةِ بِالصَفا",
      "مُذ بشرت بِسعي عَم المُصطَفى",
      "عباس أَشرَق بِالمَعالي نجمه",
      "من نير التَوفيق سَعد أَشرَقا",
      "رَقَصَت بمنيتها الغُصون بَشارَة",
      "بِقُدوم من بوجودِهِ دهر صفا",
      "قالَت ميا من بشره تهن الوَرى",
      "فَالاِمن وَالتَوفيق فَوزا أَخلَفا"
    ],
