{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "./worker.ts",
  "name": "saqi-ops",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "upload_source_maps": true,
  "preview_urls": false,
  "workers_dev": false,
  "vars": {
    "SAQI_PUBLIC_ORIGIN": "https://saqi.app",
    "SAQI_DIRECT_SOURCE_ACTIVE": "1",
    "SAQI_RIG_ACTIVE": "1",
  },
  "secrets": {
    "required": [
      "SAQI_PUBLIC_CACHE_PURGE_SECRET",
      "SAQI_ACCESS_AUDIENCE",
      "SAQI_ACCESS_TEAM_ORIGIN",
      "SAQI_SOURCE_BASE_URL",
      "SAQI_SOURCE_NAME",
    ],
  },

  "routes": [{ "pattern": "ops.saqi.app", "custom_domain": true }],
  "services": [{ "binding": "PUBLIC_SITE", "service": "saqi-public" }],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saqi-db",
      "database_id": "ffaae610-4dae-4d7e-bf86-8232f46ca2b5",
    },
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "dev": {
    "port": 8787,
    "local_protocol": "http",
  },
}
