{
  "name": "@saqi/operations",
  "description": "Authenticated collection and publication Cloudflare Worker",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "lint": "eslint .",
    "fix": "yarn fix::lint && yarn fix::format",
    "fix::lint": "eslint --fix .",
    "fix::format": "prettier --write src/",
    "check": "yarn check::lint && yarn check::format && yarn check::types",
    "check::lint": "eslint .",
    "check::format": "prettier --check src/",
    "check::types": "tsc --noEmit",
    "test": "vitest run",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:artifact": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply saqi-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply saqi-db --remote",
    "db:list": "wrangler d1 migrations list saqi-db",
    "db:execute": "wrangler d1 execute saqi-db"
  },
  "dependencies": {
    "@saqi/precedent-iso": "workspace:^",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "26.6.2",
    "better-sqlite3": "^13.0.3",
    "eslint": "10.11.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.9",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.137.0"
  }
}
