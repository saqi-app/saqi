---
import { env } from "cloudflare:workers";

import BaseLayout from "../layouts/BaseLayout.astro";
import { loadCollectionInsights } from "../lib/insights";
import { pageTitle } from "../lib/metadata";

const insights = await loadCollectionInsights(env.DB);
const number = new Intl.NumberFormat("en");
const title = pageTitle("Collection insights");
const description = "Saqi collection progress and published poem enrichment by model.";
---

<BaseLayout title={title} description={description} canonicalPath="/insights">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Poets</a>
    <h1 aria-current="page">Collection insights</h1>
  </nav>

  <div class="insights-stats">
    <section><h2>Poems</h2><p>{number.format(insights.poemCount)}</p></section>
    <section><h2>Poets</h2><p>{number.format(insights.authorCount)}</p></section>
    <section><h2>Source poems collected</h2><p>{number.format(insights.sourcePoemCount)}</p></section>
    <section>
      <h2>Estimated to collect</h2>
      <p>{insights.remainingEstimate === null ? "—" : number.format(insights.remainingEstimate)}</p>
    </section>
  </div>
  <p class="insights-note">
    The estimate sums each poet's declared count minus their cataloged poems.
    It is unavailable until a source has supplied declared counts. Daily counts
    record each source poem on its first observed UTC day.
  </p>

  <section class="insights-section" aria-labelledby="model-heading">
    <h2 id="model-heading">Published enrichment by model</h2>
    {insights.modelCounts.length === 0 ? (
      <p>No model publications yet.</p>
    ) : (
      <table>
        <thead><tr><th scope="col">Model track</th><th scope="col">Poems</th></tr></thead>
        <tbody>
          {insights.modelCounts.map(({ modelKey, poemCount }) => (
            <tr><th scope="row">{modelKey}</th><td>{number.format(poemCount)}</td></tr>
          ))}
        </tbody>
      </table>
    )}
  </section>

  <section class="insights-section" aria-labelledby="collection-heading">
    <h2 id="collection-heading">Source poems collected each day</h2>
    {insights.collectionDays.length === 0 ? (
      <p>No source poems collected yet.</p>
    ) : (
      <table>
        <thead><tr><th scope="col">UTC day</th><th scope="col">Source poems</th></tr></thead>
        <tbody>
          {insights.collectionDays.map(({ day, poemCount }) => (
            <tr><th scope="row"><time datetime={day}>{day}</time></th><td>{number.format(poemCount)}</td></tr>
          ))}
        </tbody>
      </table>
    )}
  </section>
</BaseLayout>
