{
  "name": "@saqi/precedent-iso",
  "description": "Runtime-safe shared Saqi contracts and domain models",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./canonical-html-url": {
      "types": "./src/canonical-html-url.ts",
      "import": "./dist/canonical-html-url.js"
    }
  },
  "packageManager": "yarn@4.18.1",
  "private": true,
  "sideEffects": false,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "scripts": {
    "build": "yarn run --top-level tsc",
    "test": "vitest run src",
    "watch": "yarn run --top-level tsc -w -b",
    "fix": "yarn fix::lint && yarn fix::format",
    "fix::lint": "eslint --fix .",
    "fix::format": "prettier --write .",
    "check": "yarn check::lint && yarn check::format && yarn check::types",
    "check::lint": "eslint .",
    "check::format": "prettier --check .",
    "check::types": "yarn run --top-level tsc --noEmit",
    "clean": "yarn clean::dist",
    "clean::dist": "rm -rf tsconfig.tsbuildinfo dist"
  },
  "dependencies": {
    "htmlparser2": "12.0.0",
    "zod": "4.6.7"
  }
}
