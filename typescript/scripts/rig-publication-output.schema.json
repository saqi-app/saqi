{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["translation", "wordMeanings"],
  "properties": {
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lines"],
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "wordMeanings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      }
    }
  }
}
