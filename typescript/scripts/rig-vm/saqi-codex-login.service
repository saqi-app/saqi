[Unit]
Description=Activate the authorized Saqi Codex device login
After=network-online.target
Before=saqi-translate.timer
Wants=network-online.target

[Service]
Type=oneshot
User=saqi
Group=saqi
EnvironmentFile=-/home/saqi/.config/saqi/pending-codex-login.env
ExecStartPre=+/usr/bin/systemctl stop saqi-translate.timer
ExecStart=/usr/bin/python3 /usr/local/libexec/saqi/activate-device-login.py
ExecStopPost=+/usr/bin/systemctl start --no-block saqi-translate.timer
TimeoutStartSec=infinity
UMask=0077

[Install]
WantedBy=multi-user.target
