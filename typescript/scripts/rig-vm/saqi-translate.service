[Unit]
Description=Saqi GPT-6.1 Sol High poem translator
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=saqi
Group=saqi
WorkingDirectory=/home/saqi/work/saqi
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=SAQI_RIG_ACTIVE=1
Environment=SAQI_RIG_RESULT_DIR=/home/saqi/.local/state/saqi/results
EnvironmentFile=/home/saqi/.config/saqi/access.env
ExecStart=/usr/local/bin/node /home/saqi/work/saqi/typescript/scripts/rig-local.mjs translate
TimeoutStartSec=infinity
KillMode=control-group
UMask=0077
NoNewPrivileges=true

