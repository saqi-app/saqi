{
  "manifest_version": 3,
  "name": "Saqi personal Chrome collector",
  "version": "1.2.1",
  "minimum_chrome_version": "120",
  "description": "Collect Arabic poetry using your normal Chrome session. Credentials stay in the native Saqi rig.",
  "key": "",
  "permissions": ["alarms", "nativeMessaging", "scripting", "storage"],
  "host_permissions": ["https://www.aldiwan.net/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Saqi collector: progress and controls",
    "default_popup": "popup.html"
  }
}
